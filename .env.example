# Nusxa: .env deb saqlang va qiymatlarni yozing

# Boshliq (login + parol bilan kiradi)
ADMIN_LOGIN=boshliq
ADMIN_PASSWORD=

# Boshqalar Google orqali kiradi. Client ID olish: README.md → "Google orqali kirishni sozlash"
GOOGLE_CLIENT_ID=

# Uzun tasodifiy matn (ixtiyoriy, lekin tavsiya etiladi)
SESSION_SECRET=
